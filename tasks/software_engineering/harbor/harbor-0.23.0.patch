@@ -734,7 +734,38 @@
         package_args = shlex.join(packages)
 
         if manager == "apt-get":
-            command = f"apt-get update && apt-get install -y {package_args}"
+            # Several SWE-bench Pro base images pin Debian suites that are now
+            # archived: the Release file has expired and some pinned versions
+            # were dropped from the pool, so a bare `apt-get update && install`
+            # exits non-zero with "E: Unable to fetch some archives" and kills
+            # agent setup outright. That is what blocked grok-build and
+            # muse-code on teleport, tutanota and element-web. Tolerate stale
+            # metadata, retry with --fix-missing, then verify what was actually
+            # requested is present rather than trusting apt's exit code.
+            #
+            # One unsatisfiable package must not take the rest down with it.
+            # apt treats a request as a single transaction, so an unresolvable
+            # nodejs/npm -- an archived pool that 404s, or a nodesource nodejs
+            # that Conflicts: npm -- aborts the whole thing, and ripgrep never
+            # lands even though it installs fine on its own. That is what broke
+            # codex on navidrome, tutanota and protonmail/webclients, where
+            # curl/bash/nodejs/npm were already in the image and ripgrep was the
+            # only package actually missing. Retry the stragglers one at a time
+            # before concluding anything is unavailable.
+            command = (
+                "apt-get -o Acquire::Check-Valid-Until=false update -qq || true; "
+                f"apt-get install -y {package_args} "
+                f"|| apt-get install -y --no-install-recommends --fix-missing {package_args} "
+                "|| true; "
+                f"for p in {package_args}; do "
+                '  command -v "$p" >/dev/null 2>&1 || dpkg -s "$p" >/dev/null 2>&1 '
+                '    || apt-get install -y --no-install-recommends "$p" || true; '
+                "done; "
+                f"for p in {package_args}; do "
+                '  command -v "$p" >/dev/null 2>&1 || dpkg -s "$p" >/dev/null 2>&1 '
+                '    || { echo "FATAL: apt could not provide $p" >&2; exit 1; }; '
+                "done"
+            )
             env = {"DEBIAN_FRONTEND": "noninteractive"}
         elif manager == "dnf":
             command = f"dnf install -y {package_args}"
