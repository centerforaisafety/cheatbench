+  # comes FIRST on PATH and shadows apk's /usr/bin/node. Without this the
+  # version check below still sees v16, falls through to the tarball, and
+  # overwrites /usr/local/bin/node with a build this Alpine cannot relocate.
+  _apknv=$(/usr/bin/node -v 2>/dev/null | sed 's/^v//; s/\..*//')
+  case "$_apknv" in ''|*[!0-9]*) _apknv=0;; esac
+  if [ "$_apknv" -ge @MIN@ ]; then
+    ln -sf /usr/bin/node /usr/local/bin/node
+    [ -x /usr/bin/npm ] && ln -sf /usr/bin/npm /usr/local/bin/npm
+    [ -x /usr/bin/npx ] && ln -sf /usr/bin/npx /usr/local/bin/npx
+  fi
+  hash -r
+  _nv=$(node -v 2>/dev/null | sed 's/^v//; s/\..*//')
+  case "$_nv" in ''|*[!0-9]*) _nv=0;; esac
+  if [ "$_nv" -lt @MIN@ ]; then
