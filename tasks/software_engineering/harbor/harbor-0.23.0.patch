+    # only exists from 22.15 -- 22.14 installs cleanly and then fails at runtime.
+    NV=v22.20.0
+    NURL="https://unofficial-builds.nodejs.org/download/release/${NV}/node-${NV}-linux-x64-musl.tar.gz"
+    if command -v curl >/dev/null 2>&1; then curl -fsSL "$NURL" -o /tmp/node.tgz || true
+    else wget -q -O /tmp/node.tgz "$NURL" || true; fi
+    [ -s /tmp/node.tgz ] && tar -xzf /tmp/node.tgz -C /usr/local --strip-components=1
+    rm -f /tmp/node.tgz
+    export PATH=/usr/local/bin:$PATH
+    hash -r
+  fi
+  mkdir -p "$HOME/.nvm" && printf 'export PATH="/usr/local/bin:$PATH"\n' > "$HOME/.nvm/nvm.sh"
+else
+  curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/@NVM@/install.sh | env -u NODE_VERSION bash
+  export NVM_DIR="$HOME/.nvm"
+  . "$NVM_DIR/nvm.sh" || true
+  command -v nvm >/dev/null 2>&1 || { echo "Error: NVM failed to load" >&2; exit 1; }
+  nvm install @MAJOR@ && nvm alias default @MAJOR@
+fi
+_nv=$(node -v 2>/dev/null | sed 's/^v//; s/\..*//')
+case "$_nv" in ''|*[!0-9]*) _nv=0;; esac
+[ "$_nv" -ge @MIN@ ] || { echo "FATAL: node <@MIN@ after install (got '$(node -v 2>/dev/null)')"; exit 1; }
+npm -v"""
+    # Newlines, not "; ": joining with semicolons produces `if ...; then;` and
+    # `case ...; esac;`, which are syntax errors. harbor runs this through a
+    # shell that takes a multi-line string fine.
+    # Agents disagree on how new Node must be: gemini-cli needs >= 20,
+    # kimi-code >= 22.19 (it imports createZstdDecompress from node:zlib,
+    # which does not exist before 22 -- it fails at RUNTIME on 20.15).
+    # A single hardcoded 20 let Alpine's apk node 20.8 through for kimi.
+    return (script.replace("@NVM@", NVM_VERSION)
+                  .replace("@MAJOR@", str(node_major))
+                  .replace("@MIN@", str(min_major if min_major is not None else 20)))
